{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-BACKEND.onrender.com/api/:path*"
    },
    {
      "source": "/stream/:path*",
      "destination": "https://YOUR-BACKEND.onrender.com/stream/:path*"
    }
  ]
}

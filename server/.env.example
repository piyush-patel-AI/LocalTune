# LocalTune server environment variables

# --- Core ---
PORT=5000
SESSION_SECRET=change_me_to_a_long_random_string
NODE_ENV=development            # set to "production" on Render (enables secure cross-site cookies)

# SQLite database file path (local dev / archive only).
# IGNORED whenever TURSO_DATABASE_URL is set below.
DB_PATH=./localtune.db

# --- Turso Cloud (production metadata database) ---
# When TURSO_DATABASE_URL is set, every db.js operation goes to Turso via
# @tursodatabase/serverless (pure fetch). Initialize/verify the fresh
# production database with: npm run init-turso
# Provisioning:
#   turso db create localtune-prod --location <region>
#   turso db show localtune-prod --url          -> TURSO_DATABASE_URL
#   turso db tokens create localtune-prod       -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=


# Local music directory (only used in local-dev fallback mode / for ingesting
# local files into B2 during a scan). Not needed on Render when B2 is configured.
MUSIC_DIR=./music

# --- Backblaze B2 (required in production) ---
B2_ACCOUNT_ID=your_b2_account_id            # Backblaze "KeyID"
B2_APPLICATION_KEY=your_b2_application_key  # Backblaze "applicationKey" (master or bucket key)
B2_BUCKET_NAME=localtune-media              # your bucket name
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com   # S3-compatible endpoint (see bucket details)

# Optional: public CDN base URL in front of the bucket (e.g. Cloudflare).
# If set, artwork/artist images are served from it instead of presigned URLs.
# Audio always uses short-lived presigned URLs so private buckets stay private.
# B2_PUBLIC_URL=https://cdn.yourdomain.com

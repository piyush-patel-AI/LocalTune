# LocalTune server environment variables

# --- Core ---
PORT=5000
SESSION_SECRET=change_me_to_a_long_random_string
NODE_ENV=development

# --- PostgreSQL (Supabase) ---
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Supabase ---
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # NEVER expose to browser
SUPABASE_ANON_KEY=eyJ...          # Safe for client-side

# --- Storage ---
STORAGE_BUCKET=music

# --- Legacy (remove after migration verified) ---
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# B2_ACCOUNT_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET_NAME=
# B2_ENDPOINT=

# Local music directory (for ingesting local files during scan)
MUSIC_DIR=./music
